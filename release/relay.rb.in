# Homebrew formula for the Relay helper (macOS and Linux). Generated by release/release.sh; don't edit
# the copy in the tap by hand.
class Relay < Formula
  desc "Answer Claude Code prompts from your phone"
  homepage "https://relay.relay-cloud.workers.dev"
  version "@VERSION@"
  license "Apache-2.0"

  # Bottles hold the same signed binaries as the tarballs below. Pouring one skips Homebrew's
  # source-build checks, which fail on an Xcode or CLT older than the running macOS.
  bottle do
    root_url "https://github.com/@TAP_REPO@/releases/download/v@VERSION@"
    sha256 cellar: :any_skip_relocation, arm64_ventura: "@SHA_BOTTLE_ARM64_VENTURA@"
    sha256 cellar: :any_skip_relocation, ventura:       "@SHA_BOTTLE_VENTURA@"
    sha256 cellar: :any_skip_relocation, arm64_linux:   "@SHA_BOTTLE_ARM64_LINUX@"
    sha256 cellar: :any_skip_relocation, x86_64_linux:  "@SHA_BOTTLE_X86_64_LINUX@"
  end

  on_macos do
    on_arm do
      url "https://github.com/@TAP_REPO@/releases/download/v@VERSION@/relay-@VERSION@-darwin-arm64.tar.gz"
      sha256 "@SHA_DARWIN_ARM64@"
    end
    on_intel do
      url "https://github.com/@TAP_REPO@/releases/download/v@VERSION@/relay-@VERSION@-darwin-x64.tar.gz"
      sha256 "@SHA_DARWIN_X64@"
    end
  end
  on_linux do
    on_arm do
      url "https://github.com/@TAP_REPO@/releases/download/v@VERSION@/relay-@VERSION@-linux-arm64.tar.gz"
      sha256 "@SHA_LINUX_ARM64@"
    end
    on_intel do
      url "https://github.com/@TAP_REPO@/releases/download/v@VERSION@/relay-@VERSION@-linux-x64.tar.gz"
      sha256 "@SHA_LINUX_X64@"
    end
  end

  def install
    bin.install "relay", "relay-hook"
  end

  def caveats
    <<~EOS
      To finish, run:
        relay pair
      The first time, it adds the Claude Code hooks and starts the helper, then shows a code to scan
      with the Relay app.

      To update later (the full name matters: Homebrew has an unrelated "relay" app):
        brew upgrade netchuu/tap/relay && relay install
      Replies from the phone are typed in as if you typed them in Zed's terminal, iTerm2 and tmux.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/relay --version")
  end
end
