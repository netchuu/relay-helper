{
  // Relay's end-to-end-encrypted forwarder. See docs/RELAY.md.
  "name": "relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Requests per client address (an IPv6 address counts by its /64) per minute, checked before any Durable Object
  // is touched (src/limit.ts), so one client can't flood the relay for everyone. Cloudflare counts per location,
  // and a limiter that is missing or fails lets requests through.
  //
  // The numbers are for a mobile carrier that puts a few hundred phones behind one address. A phone connects when
  // the app opens and again after a network change or a dropped connection, a few times an hour; a few hundred of
  // them make well under 120 connects a minute. Mac and phone connects are counted apart (keys "mac:" and
  // "phone:"), so phones on a busy address can't lock a Mac out. A Mac sends at most 600 pushes an hour (its room's
  // own limit) and usually a few; 60 a minute leaves room for dozens of busy Macs on one office or carrier address.
  // A script that connects to made-up rooms or posts pushes as fast as it can is stopped within a second.
  // namespace_id: any number, unique in the account.
  "ratelimits": [
    { "name": "CONNECT_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "PUSH_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ]
}
