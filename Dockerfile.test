# Runs the helper's test suite on Linux: `bun run test:linux` (native arch) or `bun run test:linux:x64`.
# The base is Debian (oven/bun's slim image is debian:bookworm-slim with Bun installed).
FROM oven/bun:1.3.10-slim

# wrangler (the relay test runs the Worker locally) needs Node; under Bun it can't forward requests.
COPY --from=node:22.12.0-bookworm-slim /usr/local/bin/node /usr/local/bin/node

# tmux for the typing tests and the tmux presence source; procps for `ps`; curl for APNs.
RUN apt-get update \
 && apt-get install -y --no-install-recommends tmux procps curl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && ln -sf "$(command -v bun)" /usr/local/bin/bunx

# Tests run as an ordinary user, like the helper does.
RUN useradd --create-home --shell /bin/bash ana
USER ana
WORKDIR /home/ana/relay

COPY --chown=ana package.json bun.lock bunfig.toml tsconfig.json ./
RUN bun install --frozen-lockfile --ignore-scripts

# The relay test runs the Cloudflare Worker locally with `wrangler dev`.
COPY --chown=ana cloud/package.json cloud/bun.lock ./cloud/
RUN cd cloud && bun install --frozen-lockfile

COPY --chown=ana cloud/src ./cloud/src
COPY --chown=ana cloud/wrangler.jsonc cloud/tsconfig.json ./cloud/
COPY --chown=ana protocol ./protocol
COPY --chown=ana mac/src ./mac/src
COPY --chown=ana mac/test ./mac/test

CMD ["sh", "-c", "bun x tsc --noEmit && bun test"]
